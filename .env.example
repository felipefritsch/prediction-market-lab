# Copy this file to .env and add project-scoped keys. Never commit the real keys.
OPENAI_API_KEY=
EXA_API_KEY=
API_FOOTBALL_KEY=
OPENROUTER_API_KEY=

# Pilot scripts (scripts/pilot/*.sh). Export these in the shell that starts a script; paths are
# relative to the repository root. See docs/runbook.md#pilot-scripts.
# PML_PILOT_DIR=data/pilot-2026-10          # required: capture/, evidence/, forecasts/ live here
# PML_PILOT_END=2026-10-18T22:35:44Z        # required: UTC end of the pilot
# PML_WATCHLIST=data/live-check/watchlist.json  # required: reviewed watchlist
# PML_BUDGET_USD=20                         # optional: shared spend cap, default 20
# PML_MAPPING=                              # optional: reviewed football-map output for evidence.sh
# PML_FORECAST_LOG_DIR=data/forecast-log    # optional: forecast-log worktree for hash publishing
# PML_CONFIG=config/default.toml            # optional: collector config
# PML_ENV_FILE=.env                         # optional: key file passed to uv --env-file
